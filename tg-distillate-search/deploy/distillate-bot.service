[Unit]
Description=Distillate chat search Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=distillate
WorkingDirectory=/opt/distillate/tg-distillate-search
EnvironmentFile=/opt/distillate/.env
ExecStart=/opt/distillate/tg-distillate-search/.venv/bin/python bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
